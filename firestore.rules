
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // == Helper Functions ==
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn();
    }

    // == Rules: Global Shared Village Data ==
    match /kegiatans/{docId} { allow read, create: if true; allow update, delete: if isSignedIn(); }
    match /personnel/{docId} { allow read: if true; allow write: if isSignedIn(); }
    match /sppds/{docId} { allow read, write: if isSignedIn(); }
    match /spjKecamatan/{docId} { allow read, write: if isSignedIn(); }
    match /dokSuratMasuk/{docId} { allow read, write: if isSignedIn(); }
    match /agenda_types/{docId} { allow read, write: if isSignedIn(); }
    match /produkHukum/{docId} { allow read, write: if isSignedIn(); }
    match /settings/village { allow read: if true; allow write: if isSignedIn(); }

    match /users/{userId} {
      allow read, write: if isSignedIn() && (isAdmin() || request.auth.uid == userId);
    }
    
    match /naskah_dinas/{docId} { allow read, write: if isSignedIn(); }
    match /buku_agenda/{docId} { allow get, list, write: if isSignedIn(); }
    match /nomor_surat/{docId} { allow read, write: if isSignedIn(); }
    match /health_records/{docId} { allow read, write: if isSignedIn(); }
    match /physical_activities/{docId} { allow read, write: if isSignedIn(); }
    
    // == Rules: PBB-P2 Collections ==
    match /pbb_dhkp/{docId} { allow read, write: if isSignedIn(); }
    match /pbb_kolektor/{docId} { allow read, write: if isSignedIn(); }
    match /pbb_wilayah/{docId} { allow read, write: if isSignedIn(); }
    match /pbb_transaksi/{docId} { allow read, write: if isSignedIn(); }
    match /pbb_setoran/{docId} { allow read, write: if isSignedIn(); }
    
    // == Rules: Antrian System Collections ==
    match /pelayanan/{docId} { allow read, write: if true; }
    match /antrian/{docId} { allow read, write: if true; }
    match /loket/{docId} { allow read, write: if true; }
    match /operators/{docId} { allow read, write: if true; }
    match /settings/{docId} { allow read, write: if true; }
    match /informasi/{docId} { allow read: if true; allow write: if isSignedIn(); }
    match /desa/{docId} { allow read: if true; allow write: if isSignedIn(); }

    // == Rules: Layanan Surat Online Warga ==
    match /submissions/{docId} { allow read, create: if true; allow update, delete: if isSignedIn(); }
    match /residents/{docId} { allow read: if true; allow write: if isSignedIn(); }

    // Default: Admin only
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
